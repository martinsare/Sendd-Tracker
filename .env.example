# =============================================================================
# Senedd Tracker Environment Template (.env.example)
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# 1. TheyWorkForYou API Key (Recommended)
# Get a free key at: https://www.theyworkforyou.com/api/key
TWFY_API_KEY=your_theyworkforyou_api_key_here

# 2. Convex Database (Recommended)
# Run `npx convex dev` to initialize your project
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# 3. Cache TTL in seconds (Default: 86400 = 24 hours)
CACHE_TTL_SECONDS=86400
